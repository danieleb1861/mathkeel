{
  "name": "@mathkeel/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local web UI of mathkeel: a restrained nautical chart of the mathematics a repository documents.",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "preview:states": "vite --open /preview.html",
