{
  "name": "mathkeel",
  "version": "0.1.0",
  "description": "Watches the mathematics a repository documents and reports when a documented result changes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mathkeel": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/types.ts"
  ],
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@toon-format/toon": "4.4.0",
    "@types/node": "^20.19.0",
    "esbuild": "0.28.2",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.0.0"
  }
}
